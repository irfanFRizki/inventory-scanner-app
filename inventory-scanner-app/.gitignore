node_modules/

# Folder android/ dibuat ulang otomatis setiap build oleh GitHub Actions
# (npx cap add android), jadi TIDAK perlu di-commit.
android/

# Keystore signing yang di-generate & di-commit otomatis oleh CI SENGAJA
# tidak di-ignore, supaya semua build memakai tanda tangan yang sama:
!ci/release.keystore

*.log
.DS_Store
